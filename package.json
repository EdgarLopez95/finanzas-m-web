{
  "name": "finanzas-m-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/run-firebase-environment.mjs EMULATOR watch",
    "dev:qa": "node scripts/run-firebase-environment.mjs QA_REAL watch",
    "dev:turbo": "node scripts/run-firebase-environment.mjs EMULATOR next dev --turbopack",
    "dev:watch": "node scripts/run-firebase-environment.mjs EMULATOR watch",
    "build": "node scripts/run-firebase-environment.mjs EMULATOR next build",
    "build:qa": "node scripts/run-firebase-environment.mjs QA_REAL next build",
    "start": "node scripts/run-firebase-environment.mjs EMULATOR next start",
    "start:qa": "node scripts/run-firebase-environment.mjs QA_REAL next start",
    "lint": "next lint",
    "test": "tsx tests/unit/run-all.ts",
    "check:rules": "node scripts/check-rules-bom.mjs",
    "fix:rules": "node scripts/check-rules-bom.mjs --fix",
    "prepare:emulator-rules": "node scripts/check-rules-bom.mjs && node scripts/canonical-backend.mjs --write",
    "pretest:emulator": "npm run prepare:emulator-rules",
    "pretest:emulator:debt-payment-gate": "npm run prepare:emulator-rules",
    "test:emulator": "npx --yes firebase-tools emulators:exec --only auth,firestore --project demo-finanzas-m-plus \"tsx tests/emulator/run-v6b6.ts\"",
    "test:emulator:r1": "npx --yes firebase-tools emulators:exec --only auth,firestore --project demo-finanzas-m-plus \"tsx tests/emulator/run-r1-atomic-cancel.ts\"",
    "test:emulator:h16b": "npx --yes firebase-tools emulators:exec --only auth,firestore --project demo-finanzas-m-plus \"tsx tests/emulator/run-h16b-cascade-cancel.ts\"",
    "test:emulator:h17": "npx --yes firebase-tools emulators:exec --only auth,firestore --project demo-finanzas-m-plus \"tsx tests/emulator/run-h17-income-projection.ts\"",
    "test:emulator:h21": "npx --yes firebase-tools emulators:exec --only auth,firestore --project demo-finanzas-m-plus \"tsx tests/emulator/run-h21-cancel-pending-share.ts\"",
    "test:emulator:debt-payment-gate": "npx --yes firebase-tools emulators:exec --only auth,firestore --project demo-finanzas-m-plus \"tsx tests/emulator/run-h-declare-debt-payment-gate.ts\"",
    "check:backend": "node scripts/canonical-backend.mjs",
    "sync:backend": "node scripts/canonical-backend.mjs --write"
  },
  "dependencies": {
    "@base-ui/react": "^1.5.0",
    "@gsap/react": "^2.1.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "firebase": "^12.14.0",
    "gsap": "^3.15.0",
    "lucide-react": "^1.17.0",
    "next": "^15.5.18",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.77.0",
    "recharts": "^3.8.1",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "15.3.3",
    "tailwindcss": "^4",
    "tsx": "^4.22.4",
    "typescript": "^5"
  }
}
